{
  "name": "roadhunt",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public,private > src/lib/supabase/database.types.ts",
    "osm:import": "tsx scripts/import-osm-germany.ts",
    "osm:import:legacy": "tsx scripts/import-osm.ts",
    "osm:export:production": "tsx scripts/transfer-production-data.ts export",
    "osm:restore:production": "tsx scripts/transfer-production-data.ts restore",
    "osm:restore:production:https": "tsx scripts/transfer-production-http.ts",
    "osm:verify:production": "tsx scripts/transfer-production-data.ts verify"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "mapbox-gl": "3.29.0",
    "next": "16.3.1",
    "next-intl": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
